# Copy to /wpa.conf on the memory stick and edit.  Remove the psk line for an open network.
ssid=MyNetwork
psk=my passphrase
# Optional: the precomputed key for exactly this ssid + psk (64 hex digits). With it the PSK is not stretched at every boot, which saves
# about 2 s. Compute it on a PC (the ssid and the passphrase go in as arguments):
#   python3 -c "import hashlib,sys;print(hashlib.pbkdf2_hmac('sha1',sys.argv[2].encode(),sys.argv[1].encode(),4096,32).hex())" MyNetwork "my passphrase"
# If the key is wrong (password changed), pnet derives it again from psk after two failed attempts.
#pmk=

